{
	"name": "cashier",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 execute cashier-db --remote --file=migrations/0000_easy_falcon.sql",
		"db:studio": "drizzle-kit studio",
		"cf:dev": "wrangler pages dev .svelte-kit/cloudflare --compatibility-date=2024-10-01 --d1=DB",
		"cf:deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20251011.0",
		"@sveltejs/adapter-auto": "^6.1.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/postcss": "^4.1.14",
		"@types/bcryptjs": "^2.4.6",
		"autoprefixer": "^10.4.21",
		"drizzle-kit": "^0.31.5",
		"drizzle-orm": "^0.44.6",
		"postcss": "^8.5.6",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"tailwindcss": "^4.1.14",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"wrangler": "^4.43.0"
	},
	"dependencies": {
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"arctic": "^3.7.0",
		"bcryptjs": "^3.0.2"
	}
}
